# Generate independent random values for both secrets. Never use these placeholders.
SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-one-time-random-setup-token
BOOTSTRAP_ENABLED=false

ENVIRONMENT=production
TESTING=false
DEMO_MODE=false
DEMO_SEED_ON_STARTUP=false

POSTGRES_USER=oraclex
POSTGRES_PASSWORD=replace-with-a-random-database-password
# URL-encode the same password if it contains reserved URL characters.
POSTGRES_PASSWORD_URLENCODED=replace-with-a-url-encoded-database-password
POSTGRES_DB=oraclex
DATABASE_URL=postgresql://oraclex:replace-with-a-random-database-password@postgres:5432/oraclex

OLLAMA_DEFAULT_MODEL=oraclex-approved:1
MODEL_REQUIRED_FOR_READINESS=false
SIMULATED_AI_FALLBACK=false
CHROMA_PERSIST_DIR=/app/data/chromadb
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=["pdf","txt","md","csv","xlsx"]
MAX_DOCUMENT_PAGES=1000
MAX_TABULAR_ROWS=10000
INGESTION_LEASE_SECONDS=120
INGESTION_POLL_SECONDS=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_REQUIRED_FOR_READINESS=true

# Pydantic parses this as JSON.
ORACLEX_HTTP_BIND=127.0.0.1
ORACLEX_HTTP_PORT=3000
ALLOWED_ORIGINS=["http://127.0.0.1:3000"]
VITE_API_BASE_URL=/api
